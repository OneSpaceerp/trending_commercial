{
  "name": "Commercial Brief",
  "module": "Trending Commercial",
  "doctype": "DocType",
  "is_submittable": 0,
  "naming_rule": "By \"Naming Series\" field",
  "autoname": "naming_series:",
  "track_changes": 1,
  "fields": [
    {
      "fieldname": "section_break_company",
      "fieldtype": "Section Break",
      "label": "1. Company & Requester"
    },
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "BRIEF-.YYYY.-",
      "default": "BRIEF-.YYYY.-",
      "reqd": 1
    },
    {
      "fieldname": "customer",
      "fieldtype": "Link",
      "label": "Client / Company",
      "options": "Customer",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company_name",
      "fieldtype": "Data",
      "label": "Client Name",
      "fetch_from": "customer.customer_name",
      "read_only": 1
    },
    {
      "fieldname": "contact_person",
      "fieldtype": "Link",
      "label": "Contact Person / Requester",
      "options": "Contact"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "New\nQualifying\nProposal\nWon\nLost\nOnHold",
      "default": "New",
      "in_list_view": 1
    },
    {
      "fieldname": "owner_user",
      "fieldtype": "Link",
      "label": "Account Manager",
      "options": "User"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "label": "Linked ERPNext Project",
      "options": "Project",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "section_break_request",
      "fieldtype": "Section Break",
      "label": "2. Request Details"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Request Title",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "vertical",
      "fieldtype": "Select",
      "label": "Vertical",
      "options": "\nEVENTS\nEMPLOYEE_EXPERIENCE\nBTL_ADVERTISING\nVENDORING_PRODUCTION",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "sub_domain",
      "fieldtype": "Select",
      "label": "Sub-Domain",
      "options": "",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "column_break_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "deal_value",
      "fieldtype": "Currency",
      "label": "Deal Value (EGP)",
      "in_list_view": 1
    },
    {
      "fieldname": "priority",
      "fieldtype": "Select",
      "label": "Priority",
      "options": "Low\nMedium\nHigh\nUrgent",
      "default": "Medium",
      "in_list_view": 1
    },
    {
      "fieldname": "expected_date",
      "fieldtype": "Date",
      "label": "Expected Delivery Date"
    },
    {
      "fieldname": "section_break_notes",
      "fieldtype": "Section Break",
      "label": "Notes & Objectives"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "General Description & Objectives"
    },
    {
      "fieldname": "section_break_questionnaire",
      "fieldtype": "Section Break",
      "label": "3. Brief Questionnaire"
    },
    {
      "fieldname": "answers_html",
      "fieldtype": "HTML",
      "label": "Dynamic Brief Questions"
    },
    {
      "fieldname": "answers_json",
      "fieldtype": "Code",
      "label": "Answers (JSON Data)",
      "options": "JSON",
      "hidden": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "import": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "permlevel": 0
    },
    {
      "role": "All",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "print": 1,
      "email": 1,
      "share": 1,
      "permlevel": 0
    }
  ],
  "allow_rename": 1,
  "show_name_in_global_search": 1
}